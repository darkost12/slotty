<div>
  <h1 class="font-bold text-4xl">Dashboard</h1>
  <p>Signed in as <%= Current.user.email_address %></p>
  <%= render(@services) || "You have no services yet." %>
  <%= link_to "Services", services_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= button_to "Sign out", session_path, method: :delete, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
