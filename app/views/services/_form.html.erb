<%= form_with(model: service, class: "contents") do |form| %>
  <% if service.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(service.errors.count, "error") %> prohibited this service from being saved:</h2>

      <ul class="list-disc ml-6">
        <% service.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["input", {"input-error": service.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :duration_minutes %>
    <%= form.number_field :duration_minutes, min: 1, step: 1, max: 480, class: ["input", {"input-error": service.errors[:duration_minutes].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :price %>
    <%= form.number_field :price, min: 0, step: 0.01, max: 999999.99, class: ["input", {"input-error": service.errors[:price].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.textarea :description, rows: 4, class: "input" %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :active %>
    <%= form.checkbox :active, class: "block shadow-sm rounded-md border order-first h-5 w-5 border-gray-400 focus:outline-blue-600" %>
  </div>

  <div class="inline">
    <%= form.submit class: "primary-button" %>
  </div>
<% end %>
