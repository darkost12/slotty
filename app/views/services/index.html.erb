<% content_for :title, "Services" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Services</h1>
    <%= link_to "New service", new_service_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="services" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @services.any? %>
      <% @services.each do |service| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render service %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Edit", edit_service_path(service), class: "primary-button" %>
            <%= button_to "Destroy", service, method: :delete, class: "danger-button", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No services found.</p>
    <% end %>

    <%= link_to "Back to dashboard", root_path, class: "secondary-button mt-6" %>
  </div>
</div>
