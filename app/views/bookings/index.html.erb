<% content_for :title, "Bookings" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Bookings</h1>
  <p class="text-gray-500 mt-2">Upcoming confirmed bookings.</p>

  <div id="bookings" class="mt-6">
    <% if @bookings.any? %>
      <% @bookings.group_by { |booking| booking.starts_at.to_date }.each do |date, bookings| %>
        <h2 class="font-bold text-xl mt-6"><%= l(date, format: :long) %></h2>

        <div class="divide-y divide-gray-200">
          <% bookings.each do |booking| %>
            <div id="<%= dom_id booking %>" class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <span class="font-medium">
                  <%= booking.starts_at.strftime("%H:%M") %>–<%= booking.ends_at.strftime("%H:%M") %>
                </span>
                · <%= booking.service.name %>
                <div class="text-gray-500 text-sm">
                  <%= booking.client_name %> · <%= mail_to booking.client_email %>
                </div>
              </div>

              <%= button_to "Cancel", cancel_booking_path(booking), method: :patch,
                    class: "text-sm text-red-600 hover:underline cursor-pointer",
                    data: { turbo_confirm: "Cancel this booking?" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="text-gray-400 py-10">No upcoming bookings.</p>
    <% end %>
  </div>

  <%= link_to "Back to dashboard", root_path, class: "secondary-button mt-6" %>
</div>
