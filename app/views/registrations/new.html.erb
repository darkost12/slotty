<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Sign up</h1>

  <%= form_with model: @user, url: registration_path do |form| %>
    <% if @user.errors.any? %>
      <ul class="text-red-500">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="flex flex-col gap-5 mt-5">
      <%= form.email_field :email_address, required: true, placeholder: "Email", class: "input" %>
      <%= form.password_field :password, required: true, placeholder: "Password", class: "input" %>
      <%= form.password_field :password_confirmation, required: true, placeholder: "Repeat password", class: "input" %>
      <div class="inline">
        <%= form.submit "Sign up", class: "primary-button" %>
      </div>
    </div>
  <% end %>
</div>
